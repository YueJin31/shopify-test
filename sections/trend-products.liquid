{{ 'trend-products.css' | asset_url | stylesheet_tag }}

{% liquid
  assign trend_products_heading = section.settings.heading
  assign trend_products_text = section.settings.text
  assign trend_products_button_label = section.settings.button_label
  assign trend_products_button_link = section.settings.button_link
  assign blocks_size = section.blocks.size
%}

<section class="trend-products js-trend-products">
  {% if trend_products_heading or trend_products_text or trend_products_button_label %}
    <div class="trend-products__header">
      {% if trend_products_heading != blank %}
        <h2 class="trend-products__heading">{{ trend_products_heading }}</h2>
      {% endif %}

      {% if trend_products_text != blank %}
        <div class="trend-products__text">{{ trend_products_text }}</div>
      {% endif %}

      {% if trend_products_button_label != blank and trend_products_button_link != blank %}
        <a class="trend-products__link" href="{{ trend_products_button_link }}">{{ trend_products_button_label }}</a>
      {% endif %}
    </div>
  {% endif %}

  {% if blocks_size > 0 %}
    <div class="trend-products__list">
      {% for block in section.blocks %}
        <div class="trend-products__item js-trend-products-item">
          {% if block.settings.image != blank %}
            <picture class="trend-products__item-picture">
              <source
                media="(max-width: 420px)"
                srcset="
                  {{ block.settings.image | image_url: width: 388 }} 1x,
                  {{ block.settings.image | image_url: width: 776 }} 2x
                "
              >

              <img
                class="trend-products__item-image"
                src="{{ block.settings.image | image_url: width: 400 }}"
                srcset="{{ block.settings.image | image_url: width: 800 }} 2x"
                alt="{{ block.settings.image.alt | escape }}"
                width="400"
                height="498"
                {% if section.index > 1 %}
                  loading="lazy"
                {% endif %}
              >
            </picture>
          {% else %}
            <div class="trend-products__item-placeholder">
              {{ 'product-apparel-3' | placeholder_svg_tag: 'trend-products__item-placeholder-svg' }}
            </div>
          {% endif %}

          {% for i in (1..3) %}
            {% assign product_key = 'product_' | append: i %}
            {% assign pos_x_key = 'product_' | append: i | append: '_horizontal' %}
            {% assign pos_y_key = 'product_' | append: i | append: '_vertical' %}

            {% assign product = block.settings[product_key] %}
            {% assign pos_x = block.settings[pos_x_key] %}
            {% assign pos_y = block.settings[pos_y_key] %}

            {% if product != blank %}
              <div class="trend-products__spot js-trend-products-spot">
                <button
                  class="trend-products__spot-button js-trend-products-spot-button"
                  style="left: {{ pos_x }}%; top: {{ pos_y }}%; transform: translate(-{{ pos_x }}%, -{{ pos_y }}%);"
                  aria-label="Open Spot Content"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M12 4L4 12" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M4 4L12 12" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                <div class="trend-products__spot-content js-trend-products-spot-content">
                  <div class="trend-products__spot-content-image-wrapper">
                    {% if product.featured_image != blank %}
                      <a class="trend-products__spot-link" href="{{ product.url }}">
                        <img
                          class="trend-products__spot-content-image"
                          src="{{ product.featured_image | image_url: width: 64 }}"
                          srcset="
                            {{ product.featured_image | image_url: width: 64 }} 1x,
                            {{ product.featured_image | image_url: width: 128 }} 2x
                          "
                          alt="{{ product.featured_image.alt | escape }}"
                          width="64"
                          height="64"
                          loading="lazy"
                        >
                      </a>

                    {% else %}
                      <a class="trend-products__spot-link" href="{{ product.url }}">
                        {{ 'product-apparel-1' | placeholder_svg_tag: 'trend-products__spot-content-svg' }}
                      </a>
                    {% endif %}
                  </div>

                  <div class="trend-products__spot-content-data">
                    <a class="trend-products__spot-title" href="{{ product.url }}">
                      {{ product.title }}
                    </a>

                    <span class="trend-products__spot-price">
                      {{ product.selected_or_first_available_variant.price | money }}
                    </span>

                    <button
                      type="button"
                      class="trend-products__spot-add-to-cart js-add-to-cart"
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      {% unless product.selected_or_first_available_variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {% if product.selected_or_first_available_variant.available %}
                        Add to cart
                      {% else %}
                        Sold out
                      {% endif %}
                    </button>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>

<script src="{{ 'trend-products.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Trend Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "name": "Trend Item",
      "type": "trend-item",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Product 1"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "product_1_horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Spot horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "product_1_vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Spot vertical position",
          "default": 50
        },
        {
          "type": "header",
          "content": "Product 2"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "product_2_horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Spot horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "product_2_vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Spot vertical position",
          "default": 50
        },
        {
          "type": "header",
          "content": "Product 3"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "product_3_horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Spot horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "product_3_vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Spot vertical position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trend Products",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
